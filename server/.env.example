# Server
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MongoDB and authentication
MONGODB_URI=mongodb://127.0.0.1:27017/carftwebai
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters

# OpenRouter AI provider
# Create a key at https://openrouter.ai/settings/keys
# Keep the real key private in server/.env. Never commit server/.env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional app attribution headers (defaults are suitable for local development)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=carftWebAI

# Website source generation
OPENROUTER_TIMEOUT_MS=300000
GENERATION_FILES_PER_BATCH=1
